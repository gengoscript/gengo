std := import("std")

// sprintf basic verbs
std.io.println(std.io.sprintf("hello %s", "world"))
std.io.println(std.io.sprintf("int %d", -42))
std.io.println(std.io.sprintf("hex %x %X", 255, 255))
std.io.println(std.io.sprintf("float %f", 3.14))
std.io.println(std.io.sprintf("bool %t %t", true, false))
std.io.println(std.io.sprintf("value %v %v %v %v", 42, "hi", true, null))
std.io.println(std.io.sprintf("%%"))
std.io.println(std.io.sprintf("multi %s %d %x", "test", 100, 171))
