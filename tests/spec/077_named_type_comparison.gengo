std := import("std")

type Age int range 0..100
type UserId string

// Same named type: comparison works
std.io.println(Age(20) == Age(20))
std.io.println(Age(20) == Age(21))
std.io.println(Age(20) != Age(21))
std.io.println(Age(20) < Age(30))
std.io.println(Age(30) > Age(20))

// Named vs raw base: allowed
std.io.println(Age(20) == 20)
std.io.println(Age(20) != 21)
std.io.println(Age(20) < 30)
std.io.println(30 > Age(20))

// String named type vs raw
std.io.println(UserId("u-1") == "u-1")
std.io.println(UserId("u-1") == "u-2")
