std := import("std")

// Generic identity function
func identity[T](x T) T {
    return x
}

assert identity[int](42) == 42
assert identity[string]("hello") == "hello"
assert identity[bool](true) == true

// Generic map function
func map_array[T, U](xs []T, f func(T) U) []U {
    result := []
    for x in xs {
        result = std.core.append(result, f(x))
    }
    return result
}

nums := [1, 2, 3, 4, 5]
doubled := map_array[int, int](nums, func(x int) int { return x * 2 })
assert std.core.len(doubled) == 5
assert doubled[0] == 2
assert doubled[4] == 10

// Generic filter function
func filter_array[T](xs []T, pred func(T) bool) []T {
    result := []
    for x in xs {
        if pred(x) {
            result = std.core.append(result, x)
        }
    }
    return result
}

evens := filter_array[int](nums, func(x int) bool { return x mod 2 == 0 })
assert std.core.len(evens) == 2
assert evens[0] == 2
assert evens[1] == 4

// Generic reduce
func reduce_array[T, U](xs []T, init U, f func(U, T) U) U {
    acc := init
    for x in xs {
        acc = f(acc, x)
    }
    return acc
}

sum := reduce_array[int, int](nums, 0, func(acc int, x int) int { return acc + x })
assert sum == 15

// Generic swap
func swap[A, B](a A, b B) (B, A) {
    return b, a
}

x, y := swap[int, string](1, "hi")
assert x == "hi"
assert y == 1

// Generic with struct types
type Box[T] struct { value T }

func unwrap[T](b Box[T]) T {
    return b.value
}

ib := Box[int]{ value: 99 }
assert unwrap[int](ib) == 99

sb := Box[string]{ value: "world" }
assert unwrap[string](sb) == "world"
