std := import("std")

// Default values for named scalar types: zero-value var decl uses default
type Id int range 1..100 default 1
type Level int default 0
type Score float range 0..10 default 0.5
type Greeting string default "hello"
type Flag bool default true
type Char rune range 65..90 default 65
type Price decimal 2 range 0..100 default 0.01

var x Id
var y Level
var z Score
var g Greeting
var f Flag
var c Char
var p Price

std.io.println(x)
std.io.println(y)
std.io.println(z)
std.io.println(g)
std.io.println(f)
std.io.println(c)
std.io.println(p)
