// Regression test: compactManagedHeap must not invalidate Zig-local []const u8
// slices held across vmAllocManagedBytes in tplValToDynStr / tplAppendValToBuilder
// / tplBuilderToStr.
//
// Strategy: keep a growing accumulator string live so the heap fills with diverse
// object sizes and eventually must compact.  After the loop, verify the last
// rendered fragment is still intact.

std := import("std")

type Html string

// Pad strings to several size classes (16 / 32 / 64 / 128 B) so we get
// cross-class fragmentation rather than single-class pressure.
pads := ["x", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"]

func render_row(i int) Html {
    pad := pads[i mod 4]
    label := "row-" + std.conv.to_string(i) + "-" + pad
    return Html(std.template.render("<tr><td>{{.}}</td></tr>", Html(label)))
}

// Build up a table by accumulating rows.  Keeping `table` live prevents GC
// from reclaiming the intermediate strings.  The accumulator is re-seeded
// every 50 rows so the live set stays bounded: the CI stress preset runs
// this suite on a 256 KB heap, and an unbounded table plus its concat
// copies does not fit there.  The deterministic compaction regression
// (400 renders against an explicit 256 KB heap) lives in chaos_spec_test's
// "template render with named-string type survives compactManagedHeap".
table := Html("")
i := 0
for i < 300 {
    table = table + render_row(i)
    if i mod 50 == 49 {
        table = render_row(i)
    }
    i = i + 1
}

// Render one more item; this is the one most likely to hit a compact boundary.
final := render_row(999)
std.io.println(string(final))
std.io.println(std.conv.to_string(std.core.len(table) > 0))
std.io.println("ok")
