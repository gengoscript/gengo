std := import("std")

type Status enum { pending = 0, active = 1, done = 2 }
type Color enum { red = 10, green = 20, blue = 30 }
type Flags enum { none = 0, read = 1, write = 2, exec = 4 }
type Plain enum { a, b, c }

std.io.println(Status.active.name)
std.io.println(Status.active.int)
std.io.println(Color.green.int)
std.io.println(Flags.exec.int)
std.io.println(Plain.b.int)

s := Status.from_int(2)
std.io.println(s)
std.io.println(s.name)

std.io.println(Status.from_int(99))
