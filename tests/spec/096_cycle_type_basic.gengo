std := import("std")

type Step int cycle 1..16
type Hour int cycle 0..23

x := Step(16)
x = x + Step(1)
std.io.println(x)
x = x - Step(1)
std.io.println(x)
std.io.println(Step.first)
std.io.println(Step.last)
std.io.println(Step.name)
std.io.println(Hour(23) + Hour(1))
std.io.println(Hour(1) - Hour(2))
