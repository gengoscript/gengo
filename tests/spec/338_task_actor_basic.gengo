// Task/actor concurrency primitive (dev-docs/design/task-actor-design.md):
// spawn via call syntax, send/receive, and request-reply via self().
// v0 scope — see task-examples/FINDINGS.md in the design doc: receive()
// returns `any` (no static message typing yet), so a task declaration
// names no message type (`type Name task func(params) { body }`) —
// every task always has a mailbox. monitor()/death notification (§6)
// is cut from v0 scope entirely (audited out — a separate feature from
// the spawn/send/receive/self() core, not required for that core to be
// useful).
std := import("std")

type WorkerMsg variant {
    add(n int),
    report(reply actor),
    stop,
}

type Worker task func(count int) {
    for {
        msg := receive()
        switch msg {
            case .add as a { count += a }
            case .report as r { r.send(count) }
            case .stop { return }
        }
    }
}

w := Worker(10)
w.send(WorkerMsg.add(5))
w.send(WorkerMsg.add(7))
w.send(WorkerMsg.report(self()))
result := receive()
std.io.println("result:", result)
w.send(WorkerMsg.stop)

// A task that never calls receive() still has a mailbox (nothing
// distinguishes it syntactically) — it just never drains it. Reports
// back the only way that works without monitor(): taking a reply
// target as an ordinary spawn parameter and send()ing to it directly.
type Ticker task func(n int, reply actor) {
    total := 0
    for i := 0; i < n; i += 1 {
        total += i
    }
    reply.send(total)
}
_ = Ticker(5, self())
ticker_result := receive()
std.io.println("ticker result:", ticker_result)
