std := import("std")

type Integer int range -2147483648 .. 2147483647
type Age Integer range 0 .. 100

// Boundary construction (from range inheritance)
std.io.println(Age(0))
std.io.println(Age(100))

// Compound ops with same-type RHS
x := Age(99)
x += Age(1)
std.io.println(x)

x -= Age(50)
std.io.println(x)

x *= Age(2)
std.io.println(x)

x /= Age(2)
std.io.println(x)
