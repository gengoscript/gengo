std := import("std")

// Methods on named int type
type Meters int

func (m Meters) doubled() Meters {
    return Meters(int(m) * 2)
}

func (m Meters) asFloat() float {
    return float(m)
}

// Methods on named range type
type Celsius float range -273.15..5000.0

func (c Celsius) toFahrenheit() float {
    return float(c) * 9.0 / 5.0 + 32.0
}

// Methods on enum type
type Direction enum { north, south, east, west }

func (d Direction) opposite() Direction {
    switch d {
        case Direction.north { return Direction.south }
        case Direction.south { return Direction.north }
        case Direction.east  { return Direction.west  }
        default              { return Direction.east  }
    }
}

d := Meters(5)
std.io.println(int(d.doubled()))
std.io.println(d.asFloat())

c := Celsius(0.0)
std.io.println(c.toFahrenheit())

dir := Direction.north
std.io.println(dir.opposite())
