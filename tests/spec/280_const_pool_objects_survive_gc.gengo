std := import("std")

// The GC root-scans only the constants that hold heap objects (a
// recorded index list) instead of walking the whole pool. This pins the
// invariant that objects whose only stable reference is the constant pool —
// anonymous function prototypes and type objects with runtime predicates —
// survive heavy collection churn.

type Score int range 0..100
type Valid int predicate func(x) { return x rem 2 == 0 }

func churn(n int) int {
    t := 0
    for i := 0; i < n; i += 1 {
        tmp := [i, i + 1, i + 2, i + 3]
        t += tmp[3]
    }
    return t
}

// The prototype for this anonymous function lives only in the const pool
// until make_closure runs; the closure keeps referencing it afterwards.
adder := func(a int, b int) int { return a + b }

c1 := churn(20000)
std.core.gc()

// Prototype must still be intact after thousands of collections.
std.io.println(adder(40, 2))

// Re-entering the same code path re-reads the function constant.
mul := func(a int, b int) int { return a * b }
c2 := churn(20000)
std.io.println(mul(6, 7))

// Predicate closure attached to a const-pool type object must survive too.
v := Valid(42)
c3 := churn(10000)
w := Valid(88)
std.io.println(int(v))
std.io.println(int(w))
std.io.println(c1 > 0 and c2 > 0 and c3 > 0)
