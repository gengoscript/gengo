std := import("std")

b := std.string.builder()
b.write("hello")
b.write(", ")
b.write("world")
std.io.println(b.str())

b2 := std.string.builder()
i := 0
for i < 5 {
    b2.write("x")
    i = i + 1
}
std.io.println(b2.str())

b3 := std.string.builder()
b3.write("abc")
b3.reset()
b3.write("xyz")
std.io.println(b3.str())
std.io.println(std.core.len(b3.str()))
