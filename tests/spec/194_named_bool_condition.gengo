std := import("std")

// Named types over bool work in every condition position through their base.
type Flag bool

f := Flag(true)
if f { std.io.println("if ok") }
if not Flag(false) { std.io.println("not ok") }
if f and Flag(true) { std.io.println("and ok") }
if Flag(false) or f { std.io.println("or ok") }
std.io.println(std.template.render("{{if .f}}template ok{{end}}", {"f": f}))

// Subtypes of a bool type inherit the behavior (#113).
subtype Strict Flag
if Strict(true) { std.io.println("subtype ok") }
