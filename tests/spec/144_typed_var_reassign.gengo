std := import("std")

// int truncates float on reassignment
var i int = 3
i = 9.7
std.io.println(i)

// float coerces int on reassignment
var f float = 1.5
f = 3
std.io.println(f)

// compound assignment requires same type
var n int = 5
n += 3
std.io.println(n)

// named return truncates
func add3() (n int) {
    n = 3.9
    return
}
std.io.println(add3())

// string reassignment works
var s string = "hello"
s = "world"
std.io.println(s)
