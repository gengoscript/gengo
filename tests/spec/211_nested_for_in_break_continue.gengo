std := import("std")

func inner_break() {
    for a in [1, 2] {
        for b in [10, 20, 30] {
            if b == 20 { break }
            std.io.print(a + b, " ")
        }
        std.io.print("| ")
    }
    std.io.println()
}

func inner_continue() {
    for a in [1, 2, 3] {
        for b in [10, 20, 30, 40] {
            if b % 20 == 0 { continue }
            std.io.print(a + b, " ")
        }
        std.io.print("| ")
    }
    std.io.println()
}

func inner_break_sum() int {
    s := 0
    for a in [1, 2, 3] {
        for b in [10, 20, 30] {
            if b == 20 { break }
            s += a + b
        }
    }
    return s
}

func inner_continue_sum() int {
    s := 0
    for a in [1, 2, 3] {
        for b in [10, 20, 30, 40] {
            if b % 20 == 0 { continue }
            s += a + b
        }
    }
    return s
}

func inner_break_outer_break() int {
    s := 0
    for a in [1, 2, 3] {
        for b in [10, 20, 30] {
            if b == 20 { break }
            s += a + b
        }
        if a == 2 { break }
    }
    return s
}

func nested_with_body_local_break() {
    for a in [1, 2] {
        for b in [10, 20, 30] {
            inner := a + b
            if b == 20 {
                std.io.print("break(", inner, ") ")
                break
            }
            std.io.print(inner, " ")
        }
    }
    std.io.println()
}

inner_break()
inner_continue()
std.io.println(inner_break_sum())
std.io.println(inner_continue_sum())
std.io.println(inner_break_outer_break())
nested_with_body_local_break()
