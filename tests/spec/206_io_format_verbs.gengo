std := import("std")

// Integer verbs
std.io.println(std.fmt.format("%d", 42))
std.io.println(std.fmt.format("%d", -42))
std.io.println(std.fmt.format("%x", 255))
std.io.println(std.fmt.format("%X", 255))
std.io.println(std.fmt.format("%o", 8))
std.io.println(std.fmt.format("%b", 5))
std.io.println(std.fmt.format("%#x", 255))
std.io.println(std.fmt.format("%#o", 8))

// Float verbs
std.io.println(std.fmt.format("%.2f", 3.14159))
std.io.println(std.fmt.format("%e", 12345.678))
std.io.println(std.fmt.format("%.3e", 12345.678))
std.io.println(std.fmt.format("%g", 0.000123))
std.io.println(std.fmt.format("%g", 1234567.0))

// Width and padding
std.io.println(std.fmt.format("%8d", 42))
std.io.println(std.fmt.format("%-8d|", 42))
std.io.println(std.fmt.format("%08d", 42))
std.io.println(std.fmt.format("%+d", 42))
std.io.println(std.fmt.format("%+d", -42))

// String verbs
std.io.println(std.fmt.format("%10s", "hi"))
std.io.println(std.fmt.format("%-10s|", "hi"))
std.io.println(std.fmt.format("%.3s", "hello"))

// Quoted
std.io.println(std.fmt.format("%q", "hello\nworld"))
