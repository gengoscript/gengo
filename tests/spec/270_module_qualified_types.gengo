std := import("std")
t := import("./modules/types/mod")

// module type as function param and return type
func make_point(x int, y int) t.Point {
    return t.Point { x: x, y: y }
}

func scale(d t.Distance, factor int) t.Distance {
    return t.Distance(int(d) * factor)
}

p := make_point(3, 4)
std.io.println(p.x)
std.io.println(p.y)

d := t.Distance(10)
d2 := scale(d, 3)
std.io.println(int(d2))

// module type in struct fields
type Segment struct { a t.Point, b t.Point }
seg := Segment { a: make_point(1, 2), b: make_point(5, 6) }
std.io.println(seg.a.x)
std.io.println(seg.b.y)

// explicit typed var declaration
var d3 t.Distance = t.Distance(7)
std.io.println(int(d3))
