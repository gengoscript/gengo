std := import("std")

// Leading dash in a character class.
assert(std.regexp.match("[-:]", ":"))
assert(std.regexp.match("[-a]", "a"))
assert(std.regexp.match("[-a]", "-"))
assert(std.regexp.match("[a-]", "a"))
assert(std.regexp.match("[\-:]", ":"))

// Negated class with leading dash
assert(std.regexp.match("[^-]", "a"))
assert(not std.regexp.match("[^-]", "-"))

// Leading and trailing dash
assert(std.regexp.match("[--]", "-"))

// Backward range produces error, not silent failure
func testBadRange() {
    defer { _ = std.core.recover() }
    std.regexp.match("[z-a]", "a")
}
testBadRange()

std.io.println("ok")
