std := import("std")

var a bigint = bigint(100)
var b bigint = bigint(200)
std.io.println(a + b)
std.io.println(a - b)
std.io.println(a * b)
std.io.println(a div b)
std.io.println(b div a)
std.io.println(-a)
std.io.println(a == bigint(100))
std.io.println(a == 100)
std.io.println(a < b)
std.io.println(b > a)
std.io.println(a.type == bigint)
std.io.println(string(a))
