fs := import("cap:fs")
std := import("std")

// Regression for the fs.list GC corruption: the fill loop must allocate
// more name bytes than one GC step (heap/4 = 128 KiB at the dev preset) so
// a collection is guaranteed to fire mid-loop. With the bug present,
// earlier names get reclaimed and reused, producing duplicate or garbage
// entries; with the fix, the result array is rooted incrementally.
dir := "tmp/list"
fs.mkdir(dir)

pad := std.string.repeat("x", 90)
i := 0
for i < 1400 {
    s := std.conv.to_string(i)
    for std.core.len(s) < 4 {
        s = "0" + s
    }
    fs.write(dir + "/f" + s + "-" + pad + ".txt", s)
    i++
}

names := std.sort.asc(fs.list(dir))

// Duplicates are adjacent after sorting.
dup := false
j := 1
for j < std.core.len(names) {
    if names[j] == names[j-1] {
        dup = true
    }
    j++
}

std.io.println(std.core.len(names))
std.io.println(!dup)
std.io.println(names[0][0:5])
std.io.println(names[1399][0:5])
