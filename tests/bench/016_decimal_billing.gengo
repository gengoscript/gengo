std := import("std")

// Billing-style workload: per-line price * quantity, accumulated into a
// running total. Exercises decimal .mul (decimalScalarPair path) and
// decimal .add (full computeAddResult generic dispatch path) back to back,
// the two decimal arithmetic ops issue #206 asks to measure before deciding
// whether dedicated decimal ops clear the specialization bar.
type Money decimal 2

price := Money(19.99)
total := Money(0)
i := 0
for ; i < 200000; i++ {
    qty := (i rem 9) + 1
    line := price * qty
    total = total + line
}

std.io.println("decimal-billing")
std.io.println(total)
