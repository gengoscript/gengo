#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

G="$ROOT/zig-out/bin/gengo"

fail=0

run() {
    echo "→ $*"
    if ! "$@"; then
        echo "FAILED: $*"
        fail=1
    fi
}

echo "=== pre-push checks ==="

run zig build -Dpreset=1m test
run zig build -Dpreset=1m parity
run zig build -Dpreset=1m bench
run zig build -Dpreset=1m native-cap
run zig build -Dpreset=1m chaos
run zig build -Dpreset=1m heap-test
run zig build -Dpreset=1m cli
# Mirror the CI stress lane (256 KB heap): tests that pass at 1m can still
# OOM there, and this was the only CI job the hook didn't cover.
run zig build -Dpreset=stress test

echo "→ example and stress scripts..."
for f in \
    tests/simple_math.gengo \
    tests/roundtrip_stdlib.gengo \
    tests/std_features.gengo \
    tests/stress/simlab/*.gengo; do
    if ! "$G" "$f" > /dev/null 2>&1; then
        echo "  FAIL: $f"
        fail=1
    else
        echo "  OK:   $f"
    fi
done

echo "→ site builder (docs e2e)..."
if ! "$G" --cap fs --mount root=. tools/site-builder/site-builder.gengo > /dev/null 2>&1; then
    echo "  FAIL: site builder"
    fail=1
else
    echo "  OK:   site builder"
fi

if [ "$fail" -ne 0 ]; then
    echo "=== pre-push FAILED — push blocked ==="
    exit 1
fi

echo "=== all checks passed ==="
