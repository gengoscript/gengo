#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

G="$ROOT/zig-out/bin/gengo"

fail=0

run() {
    echo "→ $*"
    if ! "$@"; then
        echo "FAILED: $*"
        fail=1
    fi
}

echo "=== pre-push checks ==="

# Consume stdin (push ref list) before anything else — it's a one-shot pipe.
push_entries=()
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    push_entries+=("$local_ref $local_sha $remote_ref $remote_sha")
done

# Returns 0 if every file in this push touches only documentation.
# Falls back to "not docs-only" (returns 1) for new branches where the remote
# sha is all-zeros, since we can't cheaply compute the right base.
docs_only_push() {
    local entry local_ref local_sha remote_ref remote_sha base f
    for entry in "${push_entries[@]}"; do
        read -r local_ref local_sha remote_ref remote_sha <<<"$entry"
        if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
            return 1  # new branch — run full suite to be safe
        fi
        while IFS= read -r f; do
            [[ -z "$f" ]] && continue
            case "$f" in
                docs/*|*.md|dev-docs/*|LICENSE) ;;
                *) return 1 ;;
            esac
        done < <(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null)
    done
    return 0
}

if [ ${#push_entries[@]} -gt 0 ] && docs_only_push; then
    echo "docs-only push — skipping build/test suite (docs.yml handles rendering)"
    run git diff --check
    if [ "$fail" -ne 0 ]; then
        echo "=== pre-push FAILED — push blocked ==="
        exit 1
    fi
    echo "=== all checks passed ==="
    exit 0
fi

# Mirror CI's formatting gate first — it fails in seconds, the battery in
# minutes. (CI-only lanes not mirrored here, by cost: -Dgc_stress=true test,
# -Dheap_paranoia=true test.)
run zig fmt --check build.zig src tools examples
run git diff --check

run zig build -Dpreset=1m fuzz-native
run zig build -Dpreset=1m test
run zig build -Dpreset=1m bench
run zig build -Dpreset=1m native-cap
run zig build -Dpreset=1m chaos
run zig build -Dpreset=1m heap-test
run zig build -Dpreset=1m cli
# Mirror the CI stress lane (256 KB heap): tests that pass at 1m can still
# OOM there, and this was the only CI job the hook didn't cover.
run zig build -Dpreset=stress test

echo "→ example and stress scripts..."
for f in \
    tests/simple_math.gengo \
    tests/roundtrip_stdlib.gengo \
    tests/std_features.gengo \
    tests/stress/simlab/*.gengo; do
    if ! "$G" "$f" > /dev/null 2>&1; then
        echo "  FAIL: $f"
        fail=1
    else
        echo "  OK:   $f"
    fi
done

echo "→ site builder (docs e2e)..."
if ! "$G" --heap 4m --cap fs --mount root=. tools/site-builder/site-builder.gengo > /dev/null 2>&1; then
    echo "  FAIL: site builder"
    fail=1
else
    echo "  OK:   site builder"
fi

if [ "$fail" -ne 0 ]; then
    echo "=== pre-push FAILED — push blocked ==="
    exit 1
fi

echo "=== all checks passed ==="
