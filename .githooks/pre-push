#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

G="$ROOT/zig-out/bin/gengo"

fail=0

run() {
    echo "→ $*"
    if ! "$@"; then
        echo "FAILED: $*"
        fail=1
    fi
}

echo "=== pre-push checks ==="

run zig build -Dpreset=dev test
run zig build -Dpreset=dev parity
run zig build -Dpreset=dev cli

echo "→ example and stress scripts..."
for f in \
    tests/simple_math.gengo \
    tests/roundtrip_stdlib.gengo \
    tests/std_features.gengo \
    tests/stress/simlab/*.gengo; do
    if ! "$G" "$f" > /dev/null 2>&1; then
        echo "  FAIL: $f"
        fail=1
    else
        echo "  OK:   $f"
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "=== pre-push FAILED — push blocked ==="
    exit 1
fi

echo "=== all checks passed ==="
