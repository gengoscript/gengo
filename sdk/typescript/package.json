      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.mjs",
    "prepublishOnly": "tsc"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
