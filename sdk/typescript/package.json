{
  "name": "@gengo/engine",
  "version": "0.6.0-pre1",
  "version_comment": "Keep in sync with build.zig gengo_version",
  "description": "Gengoscript embeddable scripting engine — TypeScript SDK for the WASM runtime",
  "keywords": [
    "gengo",
    "gengoscript",
    "scripting",
    "wasm",
    "engine",
    "embed",
    "sandbox"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gengoscript/gengo"
  },
