// Maze generator and solver.
//
// Generates a perfect maze using iterative DFS (recursive backtracker),
// then finds the shortest path with BFS. Every cell is reachable from
// every other cell — the maze is a spanning tree of the grid.
//
// Features used:
//   maps as a 2D grid  ·  std.rand.perm for random neighbour selection
//   explicit stacks for iterative DFS and BFS  ·  named constants
//   closures for grid helpers  ·  variant-style cell values

std := import("std")

std.rand.seed(42)

// Grid is (2·W+1) × (2·H+1): cells sit at odd coords, walls at even.
const W    int = 10
const H    int = 8
const COLS int = 21   // 2·W + 1
const ROWS int = 17   // 2·H + 1

const WALL  int = 0
const OPEN  int = 1
const START int = 2
const END   int = 3
const PATH  int = 4

func key(r int, c int) string {
    return std.conv.to_string(r) + "," + std.conv.to_string(c)
}

func gget(grid any, r int, c int) int {
    v := grid[key(r, c)]
    if v == null { return WALL }
    return int(v)
}

func makeGrid() any {
    grid := {}
    r := 0
    for r < ROWS {
        c := 0
        for c < COLS {
            grid[key(r, c)] = WALL
            c += 1
        }
        r += 1
    }
    return grid
}

// Iterative DFS — carves a perfect maze by randomly visiting unvisited
// cell-neighbours two steps away and removing the wall between them.
func generate(grid any) {
    grid[key(1, 1)] = OPEN
    stackR := [1]
    stackC := [1]

    for std.core.len(stackR) > 0 {
        top := std.core.len(stackR) - 1
        r   := int(stackR[top])
        c   := int(stackC[top])

        nrs := []
        ncs := []
        if r - 2 >= 0 && gget(grid, r-2, c) == WALL {
            nrs = std.core.append(nrs, r-2)
            ncs = std.core.append(ncs, c)
        }
        if r + 2 < ROWS && gget(grid, r+2, c) == WALL {
            nrs = std.core.append(nrs, r+2)
            ncs = std.core.append(ncs, c)
        }
        if c - 2 >= 0 && gget(grid, r, c-2) == WALL {
            nrs = std.core.append(nrs, r)
            ncs = std.core.append(ncs, c-2)
        }
        if c + 2 < COLS && gget(grid, r, c+2) == WALL {
            nrs = std.core.append(nrs, r)
            ncs = std.core.append(ncs, c+2)
        }

        cnt := std.core.len(nrs)
        if cnt == 0 {
            stackR = std.core.remove(stackR, top)
            stackC = std.core.remove(stackC, top)
            continue
        }

        perm := std.rand.perm(cnt)
        idx  := int(perm[0])
        nr   := int(nrs[idx])
        nc   := int(ncs[idx])

        // carve through the wall that sits between current cell and neighbour
        grid[key(int((r+nr)/2), int((c+nc)/2))] = OPEN
        grid[key(nr, nc)] = OPEN
        stackR = std.core.append(stackR, nr)
        stackC = std.core.append(stackC, nc)
    }
}

// BFS from (1,1) to (ROWS-2, COLS-2); records parent of each visited cell.
func bfs(grid any, parentR any, parentC any) {
    visited := {}
    sk      := key(1, 1)
    visited[sk]  = true
    parentR[sk]  = 1
    parentC[sk]  = 1
    qr := [1]
    qc := [1]

    for std.core.len(qr) > 0 {
        r  := int(qr[0])
        c  := int(qc[0])
        qr  = std.core.remove(qr, 0)
        qc  = std.core.remove(qc, 0)

        if r == ROWS - 2 && c == COLS - 2 { break }

        drs := [r-1, r+1, r,   r  ]
        dcs := [c,   c,   c-1, c+1]
        i   := 0
        for i < 4 {
            nr := int(drs[i])
            nc := int(dcs[i])
            i  += 1
            if nr < 0 || nr >= ROWS || nc < 0 || nc >= COLS { continue }
            if gget(grid, nr, nc) == WALL { continue }
            k := key(nr, nc)
            if visited[k] != null { continue }
            visited[k]   = true
            parentR[k]   = r
            parentC[k]   = c
            qr = std.core.append(qr, nr)
            qc = std.core.append(qc, nc)
        }
    }
}

// Walk the parent chain from end back to start, marking the solution path.
func markPath(grid any, parentR any, parentC any) int {
    r     := ROWS - 2
    c     := COLS - 2
    steps := 0
    for !(r == 1 && c == 1) {
        k  := key(r, c)
        grid[k] = PATH
        pr := int(parentR[k])
        pc := int(parentC[k])
        r   = pr
        c   = pc
        steps += 1
    }
    grid[key(1,      1     )] = START
    grid[key(ROWS-2, COLS-2)] = END
    return steps
}

func printMaze(grid any) {
    r := 0
    for r < ROWS {
        c := 0
        for c < COLS {
            v := gget(grid, r, c)
            if      v == WALL  { std.io.print("██") }
            else if v == OPEN  { std.io.print("  ") }
            else if v == PATH  { std.io.print("··") }
            else if v == START { std.io.print("S ") }
            else               { std.io.print("E ") }
            c += 1
        }
        std.io.println("")
        r += 1
    }
}

grid    := makeGrid()
generate(grid)
parentR := {}
parentC := {}
bfs(grid, parentR, parentC)
steps   := markPath(grid, parentR, parentC)
std.io.printf("Maze %dx%d  ·  shortest path: %d steps\n\n", W, H, steps)
printMaze(grid)
