syntax "gengo" "\.gengo$"

color brightblack "//.*$"

color brightblue "\<if\>"
color brightblue "\<else\>"
color brightblue "\<for\>"
color brightblue "\<in\>"
color brightblue "\<switch\>"
color brightblue "\<case\>"
color brightblue "\<default\>"
color brightblue "\<return\>"
color brightblue "\<func\>"
color brightblue "\<struct\>"
color brightblue "\<interface\>"
color brightblue "\<enum\>"
color brightblue "\<type\>"
color brightblue "\<range\>"
color brightblue "\<var\>"
color brightblue "\<const\>"
color brightblue "\<defer\>"
color brightblue "\<import\>"
color brightblue "\<break\>"
color brightblue "\<continue\>"

color magenta "\<true\>"
color magenta "\<false\>"
color magenta "\<null\>"

color cyan "\<int\>"
color cyan "\<float\>"
color cyan "\<bool\>"

color yellow "\<[0-9]+\>"
color yellow "\<[0-9]+\.[0-9]+\>"

color green "\"[^\"]*\""
color green "'[^']*'"
color green "^[[:space:]]*\\\\\\\\.*$"
color brightmagenta "`[^`]*`"

color brightred ":="
color brightred "=="
color brightred "!="
color brightred "<="
color brightred ">="
color brightred "&&"
color brightred "||"
color brightred "<<"
color brightred ">>"
color brightred "\+="
color brightred "-="
color brightred "\*="
color brightred "/="
color brightred "%="
color brightred "&="
color brightred "\|="
color brightred "\^="
color brightred "[=+*/%&|^~!<>?:.,;(){}\[\]-]"

