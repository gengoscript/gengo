// site-builder.gengo — Static site generator for Gengoscript documentation.
//
// Usage (from repository root):
//   gengo --heap 4m --cap fs --mount root=. tools/site-builder/site-builder.gengo
//
// Reads .md files from root/docs/ and writes HTML to root/build/site/.
// docs/index.md becomes the intro of the generated index page.
// Requires cap:fs capability.

std := import("std")
fs := import("cap:fs")

core := std.core
str  := std.string
io   := std.io
fmt  := std.fmt

// ── Configuration ────────────────────────────────────────────────────────────

const srcDir    := "root/docs"
const outDir    := "root/build/site"
const staticDir := "root/tools/site-builder/static"
const cssPath   := "style.css"
const siteBase  := "https://docs.gengoscript.org/"
const repoBlob  := "https://github.com/gengoscript/gengo/blob/main/"
// Keep this in sync with build.zig. The -dev suffix means this site documents
// main branch, not a released compatibility guarantee.
const documentationVersion := "0.5.1-dev"

// Reading order: listed chapters first, anything new lands at the end
// in filename order.
const chapterOrder := [
    "project-status.md",
    "quickstart.md",
    "cli.md",
    "tutorial-first-script.md",
    "language.md",
    "stdlib.md",
    "embedding.md",
    "engine-api.md",
    "host-abi.md",
    "typescript-sdk.md",
    "capabilities.md",
    "capability-matrix.md",
    "security.md",
    "known-limitations.md",
    "error-catalogue.md",
    "changelog.md",
]


// Escaped/rendered HTML. Raw strings do not concatenate with Html — the
// type system forces every dynamic piece through an escape function (or an
// explicit Html(...) assertion for trusted markup).
type Html string

// One rendered documentation page.
type Page struct {
    file  string,    // markdown filename under docs/
    out   string,    // rendered filename
    title string,    // first H1, or the filename
    desc  string,    // first plain paragraph, for <meta description>
}

// Rendered page filenames (filled before rendering); .md references that
// resolve to one of these become local links, anything else goes to GitHub.
var knownPages := {}

// GitHub Pages builds have a checkout. Resolve both detached-HEAD and ordinary
// ref checkouts so every generated page can identify its source revision.
func documentationBuildId() string {
    if not fs.exists("root/.git/HEAD") { return "main branch (commit unavailable)" }
    const head := str.trim(fs.read("root/.git/HEAD"))
    if not str.starts_with(head, "ref: ") { return head }
    const refPath := "root/.git/" + head[5:]
    if fs.exists(refPath) { return str.trim(fs.read(refPath)) }
    return "main branch (commit unavailable)"
}

// ── Page templates ───────────────────────────────────────────────────────────

const pageShellSrc :=
    \\<!DOCTYPE html>
    \\<html lang="en">
    \\<head>
    \\<meta charset="utf-8">
    \\<meta name="viewport" content="width=device-width, initial-scale=1">
    \\<title>{{.title}}</title>
    \\<meta name="description" content="{{.desc}}">
    \\<meta name="robots" content="index,follow,max-image-preview:large">
    \\<meta name="application-name" content="Gengoscript Documentation">
    \\<link rel="canonical" href="{{.canonical}}">
    \\<meta property="og:type" content="{{.ogType}}">
    \\<meta property="og:locale" content="en_US">
    \\<meta property="og:title" content="{{.title}}">
    \\<meta property="og:description" content="{{.desc}}">
    \\<meta property="og:url" content="{{.canonical}}">
    \\<meta property="og:site_name" content="Gengoscript">
    \\<script type="application/ld+json">{{.jsonLd}}</script>
    \\<link rel="stylesheet" href="{{.css}}">
    \\</head>
    \\<body>
    \\<a class="skip-link" href="#content">Skip to content</a>
    \\<nav class="site-nav" aria-label="Primary">
    \\<a href="index.html">Docs</a> · <a href="quickstart.html">Start</a> · <a href="language.html">Language</a> · <a href="engine-api.html">Host integration</a> · <a href="security.html">Security</a> <span class="doc-version">{{.version}}</span>
    \\</nav>
    \\{{if .hasBreadcrumb}}<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="index.html">Documentation</a> / {{.breadcrumb}}</nav>{{end}}
    \\<main id="content">
    \\{{.toc}}
    \\{{.body}}
    \\<footer class="site-footer">
    \\<p class="colophon">This page was generated by <a href="{{.builderUrl}}">a Gengoscript script</a> &mdash; the language documenting itself.</p>
    \\<p class="doc-status">Documentation status: main branch / unreleased (pre-1.0). Build: {{.build}}. <a href="changelog.html">Changelog</a></p>
    \\</footer>
    \\</main>
    \\</body>
    \\</html>

const pageShell := std.template.parse(pageShellSrc)

const footerSrc :=
    \\<hr>
    \\<footer class="pagenav">
    \\<span class="prev">{{if .hasPrev}}&larr; <a href="{{.prevPath}}">{{.prevTitle}}</a>{{end}}</span>
    \\<span class="up"><a href="index.html">Contents</a></span>
    \\<span class="next">{{if .hasNext}}<a href="{{.nextPath}}">{{.nextTitle}}</a> &rarr;{{end}}</span>
    \\</footer>

const footerTmpl := std.template.parse(footerSrc)

// ── String helpers ───────────────────────────────────────────────────────────

func escapeHtml(s string) Html {
    var r := str.replace(s, "&", "&amp;")
    r = str.replace(r, "<", "&lt;")
    return Html(str.replace(r, ">", "&gt;"))
}

func escapeAttr(s string) Html {
    var r := str.replace(s, "&", "&amp;")
    r = str.replace(r, "<", "&lt;")
    r = str.replace(r, ">", "&gt;")
    return Html(str.replace(r, '"', "&quot;"))
}

func pageJsonLd(page Page, canonical string, ogType string) Html {
    var schemaType := "WebPage"
    if ogType == "website" { schemaType = "WebSite" }
    var json := std.json.stringify({
        "@context": "https://schema.org",
        "@type": schemaType,
        "name": page.title,
        "description": page.desc,
        "url": canonical,
        "inLanguage": "en",
        "isPartOf": "https://docs.gengoscript.org/",
    })
    // Avoid closing the script element if a trusted markdown heading or
    // description happens to contain a less-than sign.
    json = str.replace(json, "<", '\\u003c')
    return Html(json)
}

// std.string.trim trims both ends; the renderer sometimes needs right-only.
func trimEnd(s string) string {
    var end := core.len(s)
    for end > 0 and str.contains(" \t\n\r", s[end-1:end]) {
        end -= 1
    }
    return s[0:end]
}

func trimPrefix(s string, prefix string) string {
    if str.starts_with(s, prefix) {
        return s[core.len(prefix):]
    }
    return s
}

// "stdlib.md" -> "stdlib"; leaves names without an extension alone.
func stripExt(path string) string {
    dot := str.last_index_of(path, ".")
    if dot > str.last_index_of(path, "/") {
        return path[0:dot]
    }
    return path
}

// Index of sub in s at or after from, or -1.
func indexFrom(s string, sub string, from int) int {
    idx := str.index_of(s[from:], sub)
    if idx == -1 { return -1 }
    return from + idx
}

// ── Link resolution ──────────────────────────────────────────────────────────

// Split "page.md#anchor" into the path and its "#anchor" suffix.
func splitFragment(url string) (string, string) {
    if not str.contains(url, "#") { return url, "" }
    bits := str.split_once(url, "#")
    return bits[0], "#" + bits[1]
}

// Map a markdown link target to a usable href. Targets ending in .md become
// links to the rendered page when we built one, or to the GitHub blob
// otherwise. Anything else passes through untouched.
func mdHref(url string) string {
    if str.contains(url, "://") { return url }
    base, frag := splitFragment(url)
    if not str.ends_with(base, ".md") { return url }

    // A sibling .md that we rendered becomes its .html name.
    p := trimPrefix(trimPrefix(base, "./"), "docs/")
    page := stripExt(p) + ".html"
    if not str.contains(p, "/") and knownPages[page] != null {
        return page + frag
    }

    // GitHub fallback: links are written relative to docs/, so "../x" means
    // the repository root and a bare sibling name means docs/ itself.
    var rp := trimPrefix(base, "./")
    var ups := false
    for str.starts_with(rp, "../") {
        rp = rp[3:]
        ups = true
    }
    if not ups and not str.contains(rp, "/") {
        rp = "docs/" + rp
    }
    return repoBlob + rp + frag
}

// A code span like `docs/stdlib.md` is a doc reference worth linking.
func looksLikeDocPath(t string) bool {
    return str.ends_with(t, ".md") and not str.contains(t, " ") and core.len(t) > 3
}

// ── Tables ───────────────────────────────────────────────────────────────────

const sepCell := std.regexp.compile('^[-:]+$')

// Split "| a | b |" into trimmed cells, dropping the outer pipes.
func splitRow(row string) []string {
    var r := row
    if str.starts_with(r, "|") { r = r[1:] }
    if str.ends_with(r, "|") { r = r[0:core.len(r)-1] }
    var cells := []
    var cell := ""
    var i := 0
    for i < core.len(r) {
        const ch := r[i:i+1]
        if ch == "\\" and i+1 < core.len(r) and r[i+1:i+2] == "|" {
            cell += "|"
            i += 2
            continue
        }
        if ch == "|" {
            cells = core.append(cells, str.trim(cell))
            cell = ""
        } else {
            cell += ch
        }
        i += 1
    }
    cells = core.append(cells, str.trim(cell))
    return cells
}

// True for the |---|:---:| alignment row.
func isSeparatorRow(cells []string) bool {
    if core.len(cells) == 0 { return false }
    for c in cells {
        if not sepCell.match(c) { return false }
    }
    return true
}

func renderTable(rows []string) Html {
    var out := std.string.builder()
    out.write("<table>\n")
    var bodyStart := 0
    if core.len(rows) > 1 and isSeparatorRow(splitRow(rows[1])) {
        bodyStart = 2
        out.write("<thead><tr>")
        for cell in splitRow(rows[0]) {
            out.write("<th>")
            out.write(inlineMdToHtml(cell))
            out.write("</th>")
        }
        out.write("</tr></thead>\n")
    }
    out.write("<tbody>\n")
    for row in rows[bodyStart:] {
        out.write("<tr>")
        for cell in splitRow(row) {
            out.write("<td>")
            out.write(inlineMdToHtml(cell))
            out.write("</td>")
        }
        out.write("</tr>\n")
    }
    out.write("</tbody>\n</table>\n")
    return Html(out.str())
}

// ── Markdown → HTML: block level ─────────────────────────────────────────────

const olMarker := std.regexp.compile('^[0-9]+\. ')

// Length of an ordered-list marker ("12. "), or 0 if the line has none.
func orderedPrefix(line string) int {
    m := olMarker.find(line)
    if m == null { return 0 }
    return core.len(m)
}

// Heading depth 1–6 when the line starts with the right number of '#' chars
// followed by a space; returns 0 for anything else.
func headingLevel(line string) int {
    var k := 0
    for k < core.len(line) and line[k] == '#' {
        k += 1
    }
    if k >= 1 and k <= 6 and k < core.len(line) and line[k] == ' ' {
        return k
    }
    return 0
}

func isGengoIdentByte(ch string) bool {
    return str.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch)
}

func isGengoDigit(ch string) bool {
    return str.contains("0123456789", ch)
}

func isGengoKeyword(word string) bool {
    const words := "|and|as|assert|break|case|const|continue|defer|div|else|enum|false|for|func|if|import|in|interface|mod|not|null|or|pub|rem|return|struct|subtype|switch|test|trap|true|type|var|variant|when|range|cycle|default|predicate|message|"
    return str.contains(words, "|" + word + "|")
}

// The site builder cannot import the compiler lexer, so this intentionally
// mirrors its public token categories rather than attempting to parse code.
func highlightGengo(src string) Html {
    var out := std.string.builder()
    var i := 0
    for i < core.len(src) {
        const ch := src[i:i+1]
        if str.starts_with(src[i:], "//") {
            var end := indexFrom(src, "\n", i)
            if end == -1 { end = core.len(src) }
            out.write("<span class=\"tok-comment\">")
            out.write(escapeHtml(src[i:end]))
            out.write("</span>")
            i = end
            continue
        }
        if str.starts_with(src[i:], "/*") {
            var end := indexFrom(src, "*/", i+2)
            if end == -1 { end = core.len(src) } else { end += 2 }
            out.write("<span class=\"tok-comment\">")
            out.write(escapeHtml(src[i:end]))
            out.write("</span>")
            i = end
            continue
        }
        if ch == "\"" or ch == "'" or ch == "`" {
            var end := i + 1
            for end < core.len(src) {
                const next := src[end:end+1]
                if next == "\\" and end + 1 < core.len(src) {
                    end += 2
                    continue
                }
                end += 1
                if next == ch { break }
            }
            out.write("<span class=\"tok-string\">")
            out.write(escapeHtml(src[i:end]))
            out.write("</span>")
            i = end
            continue
        }
        if isGengoDigit(ch) {
            var end := i + 1
            for end < core.len(src) and str.contains("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ._", src[end:end+1]) {
                end += 1
            }
            out.write("<span class=\"tok-number\">")
            out.write(escapeHtml(src[i:end]))
            out.write("</span>")
            i = end
            continue
        }
        if isGengoIdentByte(ch) and not isGengoDigit(ch) {
            var end := i + 1
            for end < core.len(src) and isGengoIdentByte(src[end:end+1]) { end += 1 }
            const word := src[i:end]
            if isGengoKeyword(word) {
                out.write("<span class=\"tok-keyword\">")
                out.write(escapeHtml(word))
                out.write("</span>")
            } else {
                out.write(escapeHtml(word))
            }
            i = end
            continue
        }
        out.write(escapeHtml(ch))
        i += 1
    }
    return Html(out.str())
}

// Stable, ASCII-safe heading IDs. Separators collapse to one dash so markup
// such as inline code does not leak into URL fragments.
func headingSlug(text string) string {
    const lower := str.lower(text)
    var out := std.string.builder()
    var separator := false
    for i := 0; i < core.len(lower); i += 1 {
        const ch := lower[i:i+1]
        const word := str.contains("abcdefghijklmnopqrstuvwxyz0123456789", ch)
        if word {
            if separator and core.len(out.str()) > 0 { out.write("-") }
            out.write(ch)
            separator = false
        } else {
            separator = true
        }
    }
    if core.len(out.str()) == 0 { return "section" }
    return out.str()
}

func mdToHtml(src string) Html {
    var html := std.string.builder()
    var lines := str.split(src, "\n")
    var i := 0
    var inCode := false
    var codeIsRawHtml := false
    var codeLang := ""
    var codeBuf := ""
    var paraBuf := ""
    var ulOpen := false
    var liOpen := false    // level-1 <li> stays open so a nested list can live inside it
    var nestedOpen := false
    var olOpen := false
    var headingIds := {}

    func flushPara() {
        if paraBuf != "" {
            p := trimEnd(paraBuf)
            if p != "" {
                html.write("<p>")
                html.write(inlineMdToHtml(p))
                html.write("</p>\n")
            }
            paraBuf = ""
        }
    }

    func closeLists() {
        if nestedOpen {
            html.write("</ul>\n")
            nestedOpen = false
        }
        if liOpen {
            html.write("</li>\n")
            liOpen = false
        }
        if ulOpen {
            html.write("</ul>\n")
            ulOpen = false
        }
        if olOpen {
            html.write("</ol>\n")
            olOpen = false
        }
    }

    for i < core.len(lines) {
        var line := lines[i]
        i += 1

        // Code blocks
        if str.starts_with(line, "```") {
            if inCode {
                if codeIsRawHtml {
                    html.write(Html(trimEnd(codeBuf)))
                    html.write("\n")
                } else {
                    if codeLang == "gengo" {
                        html.write("<pre><code class=\"language-gengo\">")
                        html.write(highlightGengo(trimEnd(codeBuf)))
                    } else {
                        html.write("<pre><code>")
                        html.write(escapeHtml(trimEnd(codeBuf)))
                    }
                    html.write("</code></pre>\n")
                }
                codeBuf = ""
                inCode = false
                codeIsRawHtml = false
            } else {
                flushPara()
                closeLists()
                inCode = true
                codeLang = str.trim(line[3:])
                codeIsRawHtml = codeLang == "html"
            }
            continue
        }
        if inCode {
            codeBuf += line + "\n"
            continue
        }

        // Tables: consume the whole run of |-prefixed lines.
        t := str.trim(line)
        if str.starts_with(t, "|") {
            flushPara()
            closeLists()
            var rows := [t]
            for i < core.len(lines) {
                nt := str.trim(lines[i])
                if not str.starts_with(nt, "|") { break }
                rows = core.append(rows, nt)
                i += 1
            }
            html.write(renderTable(rows))
            continue
        }

        // Headings
        level := headingLevel(line)
        if level > 0 {
            flushPara()
            closeLists()
            tag := "h" + std.conv.to_string(level)
            id := headingSlug(line[level+1:])
            assert(headingIds[id] == null)
            headingIds[id] = true
            html.write("<" + tag + " id=\"")
            html.write(escapeAttr(id))
            html.write("\">")
            html.write(inlineMdToHtml(line[level+1:]))
            html.write("</" + tag + ">\n")
            continue
        }

        // Horizontal rule
        if line == "---" or line == "***" or line == "___" {
            flushPara()
            closeLists()
            html.write("<hr>\n")
            continue
        }

        // Blockquote
        if str.starts_with(line, "> ") {
            flushPara()
            closeLists()
            html.write("<blockquote>")
            html.write(inlineMdToHtml(line[2:]))
            html.write("</blockquote>\n")
            continue
        }

        // Nested list items (two-space indent under an open item)
        if str.starts_with(line, "  - ") or str.starts_with(line, "  * ") {
            if liOpen {
                flushPara()
                if not nestedOpen {
                    html.write("\n<ul>\n")
                    nestedOpen = true
                }
                html.write("<li>")
                html.write(inlineMdToHtml(line[4:]))
                html.write("</li>\n")
                continue
            }
            // No open parent item: treat as a top-level item.
            line = line[2:]
        }

        // Unordered list items
        if str.starts_with(line, "- ") or str.starts_with(line, "* ") {
            flushPara()
            if olOpen {
                html.write("</ol>\n")
                olOpen = false
            }
            if nestedOpen {
                html.write("</ul>\n")
                nestedOpen = false
            }
            if liOpen {
                html.write("</li>\n")
                liOpen = false
            }
            if not ulOpen {
                html.write("<ul>\n")
                ulOpen = true
            }
            html.write("<li>")
            html.write(inlineMdToHtml(line[2:]))
            liOpen = true
            continue
        }

        // Ordered list items
        op := orderedPrefix(line)
        if op > 0 {
            flushPara()
            if nestedOpen {
                html.write("</ul>\n")
                nestedOpen = false
            }
            if liOpen {
                html.write("</li>\n")
                liOpen = false
            }
            if ulOpen {
                html.write("</ul>\n")
                ulOpen = false
            }
            if not olOpen {
                html.write("<ol>\n")
                olOpen = true
            }
            html.write("<li>")
            html.write(inlineMdToHtml(line[op:]))
            html.write("</li>\n")
            continue
        }

        // Empty line ends a paragraph; lists stay open across blank lines.
        if t == "" {
            flushPara()
            continue
        }

        // Plain text ends any open list, then accumulates as a paragraph.
        closeLists()
        if paraBuf != "" {
            paraBuf += " "
        }
        paraBuf += line
    }

    flushPara()
    closeLists()
    return Html(html.str())
}

// ── Markdown → HTML: inline level ────────────────────────────────────────────

// Parse "[text](url)" where s[open] is "["; returns text, url, and the index
// just past the closing ")", or ("", "", -1) when it is not a link.
func bracketPair(s string, open int) (string, string, int) {
    closeB := indexFrom(s, "]", open+1)
    if closeB == -1 or closeB+1 >= core.len(s) or s[closeB+1] != '(' {
        return "", "", -1
    }
    closeP := indexFrom(s, ")", closeB+2)
    if closeP == -1 {
        return "", "", -1
    }
    return s[open+1:closeB], s[closeB+2:closeP], closeP + 1
}

// Text enclosed by marker, scanning from `from`; returns the inner text and
// the index just past the closing marker, or ("", -1) when unclosed.
func span(s string, from int, marker string) (string, int) {
    closeAt := indexFrom(s, marker, from)
    if closeAt == -1 { return "", -1 }
    return s[from:closeAt], closeAt + core.len(marker)
}

// Inline markdown: links, images, bold, italic, inline code.
func inlineMdToHtml(s string) Html {
    var out := std.string.builder()
    n := core.len(s)
    var i := 0
    for i < n {
        ch := s[i:i+1]

        // Links: [text](url)
        if ch == "[" {
            text, url, next := bracketPair(s, i)
            if next != -1 {
                out.write("<a href=\"")
                out.write(escapeAttr(mdHref(url)))
                out.write("\">")
                out.write(inlineMdToHtml(text))
                out.write("</a>")
                i = next
                continue
            }
        }

        // Images: ![alt](url)
        if ch == "!" and i+1 < n and s[i+1] == '[' {
            alt, url, next := bracketPair(s, i+1)
            if next != -1 {
                out.write("<img src=\"")
                out.write(escapeHtml(url))
                out.write("\" alt=\"")
                out.write(escapeHtml(alt))
                out.write("\">")
                i = next
                continue
            }
        }

        // Bold: **text**
        if ch == "*" and i+1 < n and s[i+1] == '*' {
            text, next := span(s, i+2, "**")
            if next != -1 {
                out.write("<strong>")
                out.write(inlineMdToHtml(text))
                out.write("</strong>")
                i = next
                continue
            }
        }

        // Italic: *text* (underscores are too common in identifiers to risk)
        if ch == "*" {
            text, next := span(s, i+1, "*")
            if next != -1 {
                out.write("<em>")
                out.write(inlineMdToHtml(text))
                out.write("</em>")
                i = next
                continue
            }
        }

        // Inline code: `text`; doc references become links.
        if ch == "`" {
            text, next := span(s, i+1, "`")
            if next != -1 {
                code := Html("<code>") + escapeHtml(text) + Html("</code>")
                if looksLikeDocPath(text) {
                    code = Html("<a href=\"") + escapeAttr(mdHref(text)) + Html("\">") + code + Html("</a>")
                }
                out.write(code)
                i = next
                continue
            }
        }

        if ch == "&" {
            out.write("&amp;")
        } else if ch == "<" {
            out.write("&lt;")
        } else if ch == ">" {
            out.write("&gt;")
        } else {
            out.write(ch)
        }
        i += 1
    }
    return Html(out.str())
}

// ── Page metadata ────────────────────────────────────────────────────────────

// Title from the first H1 in the markdown source, or the fallback.
func extractTitle(src string, fallback string) string {
    for line in str.split(src, "\n") {
        if str.starts_with(line, "# ") {
            return str.trim(line[2:])
        }
    }
    return fallback
}

// Meta description from the first plain paragraph of the markdown source.
func extractDescription(src string, fallback string) string {
    var inCode := false
    for line in str.split(src, "\n") {
        t := str.trim(line)
        if str.starts_with(t, "```") {
            inCode = not inCode
            continue
        }
        if inCode or t == "" { continue }
        if str.starts_with(t, "#") { continue }
        if str.starts_with(t, "- ") or str.starts_with(t, "* ") { continue }
        if str.starts_with(t, "|") or str.starts_with(t, ">") { continue }
        d := str.replace(str.replace(t, "`", ""), "**", "")
        if core.len(d) > 155 {
            d = d[0:152] + "..."
        }
        return d
    }
    return fallback
}

func pageToc(src string) Html {
    var out := std.string.builder()
    var open := false
    for line in str.split(src, "\n") {
        const level := headingLevel(line)
        if level != 2 { continue }
        const text := line[level+1:]
        const id := headingSlug(text)
        if not open {
            out.write("<aside class=\"page-toc\" aria-label=\"On this page\"><strong>On this page</strong><ul>\n")
            open = true
        }
        out.write("<li class=\"toc-level-" + std.conv.to_string(level) + "\"><a href=\"#")
        out.write(escapeAttr(id))
        out.write("\">")
        out.write(inlineMdToHtml(text))
        out.write("</a></li>\n")
    }
    if open { out.write("</ul></aside>\n") }
    return Html(out.str())
}

// ── Page assembly ────────────────────────────────────────────────────────────

// Wrap rendered body HTML in the full page shell.
func wrapPage(page Page, body Html) Html {
    var canonical := siteBase + page.out
    var ogType := "article"
    if page.out == "index.html" {
        canonical = siteBase
        ogType = "website"
    }
    var toc := Html("")
    if page.out != "index.html" {
        toc = pageToc(fs.read(srcDir + "/" + page.file))
    }
    return Html(pageShell.execute({
        "title":      escapeAttr(page.title),
        "desc":       escapeAttr(page.desc),
        "canonical":  escapeAttr(canonical),
        "ogType":     ogType,
        "jsonLd":     pageJsonLd(page, canonical, ogType),
        "css":        cssPath,
        "body":       body,
        "builderUrl": repoBlob + "tools/site-builder/site-builder.gengo",
        "version":    documentationVersion,
        "build":      escapeHtml(documentationBuildId()),
        "hasBreadcrumb": page.out != "index.html",
        "breadcrumb": escapeHtml(page.title),
        "toc":        toc,
    }))
}

// Previous chapter on the left, contents in the middle, next on the right.
func pageFooter(prev ?Page, next ?Page) Html {
    var data := {
        "hasPrev": prev != null, "prevPath": "", "prevTitle": "",
        "hasNext": next != null, "nextPath": "", "nextTitle": "",
    }
    if prev != null {
        data["prevPath"] = prev.out
        data["prevTitle"] = escapeHtml(prev.title)
    }
    if next != null {
        data["nextPath"] = next.out
        data["nextTitle"] = escapeHtml(next.title)
    }
    return Html(trimEnd(footerTmpl.execute(data)))
}

// ── Main ─────────────────────────────────────────────────────────────────────

func main() {
    fs.mkdir(outDir)
    // The output directory is an exact projection of docs/. Removing prior
    // files prevents deleted chapters from remaining deployed as stale URLs.
    for f in fs.list(outDir) {
        fs.delete(outDir + "/" + f)
    }

    // Counts actual writes, so the line is honest even after a mid-build panic.
    var written := 0
    defer func() {
        io.println(fmt.format("Built %d pages to %s", written, outDir))
    }()

    // Discover sources: every .md except index.md, which becomes the intro.
    var mdFiles := []
    var hasIndexMd := false
    for f in fs.list(srcDir) {
        if f == "index.md" {
            hasIndexMd = true
        } else if str.ends_with(f, ".md") {
            mdFiles = core.append(mdFiles, f)
        }
    }
    mdFiles = std.sort.asc(mdFiles)

    // Listed chapters first, newcomers after in filename order.
    var present := {}
    for f in mdFiles { present[f] = true }
    var listed := {}
    for c in chapterOrder { listed[c] = true }
    var ordered := []
    for c in chapterOrder {
        // A chapter-order entry is a publication contract, not a best-effort
        // preference. Fail the build rather than silently dropping it.
        assert(present[c] != null)
        ordered = core.append(ordered, c)
    }
    for f in mdFiles {
        if listed[f] == null { ordered = core.append(ordered, f) }
    }

    // First pass: titles and the known-page set, so each page can name its
    // neighbours and .md references can resolve to local links.
    var pages := []
    for f in ordered {
        src := fs.read(srcDir + "/" + f)
        title := extractTitle(src, stripExt(f))
        pages = core.append(pages, Page{
            file:  f,
            out:   stripExt(f) + ".html",
            title: title,
            desc:  extractDescription(src, title),
        })
        knownPages[stripExt(f) + ".html"] = true
    }

    // Second pass: render each chapter with prev/next footers.
    for k := 0; k < core.len(pages); k++ {
        page := pages[k]
        var prev := null
        var next := null
        if k > 0 { prev = pages[k-1] }
        if k+1 < core.len(pages) { next = pages[k+1] }
        body := mdToHtml(fs.read(srcDir + "/" + page.file)) + pageFooter(prev, next)
        fs.write(outDir + "/" + page.out, string(wrapPage(page, body)))
        written += 1
    }

    // Index page: docs/index.md as the intro, then the table of contents.
    var intro := Html("<h1>Gengoscript Documentation</h1>\n")
    var indexDesc := "Documentation for Gengoscript, the embeddable scripting language with domain-safe types."
    if hasIndexMd {
        src := fs.read(srcDir + "/index.md")
        intro = mdToHtml(src)
        indexDesc = extractDescription(src, indexDesc)
    }
    var toc := std.string.builder()
    toc.write(intro)
    toc.write("<h2 id=\"contents\">Contents</h2>\n<ul>\n")
    for page in pages {
        toc.write("<li><a href=\"" + page.out + "\">")
        toc.write(escapeHtml(page.title))
        toc.write("</a></li>\n")
    }
    toc.write("</ul>\n")
    index := Page{
        file:  "index.md",
        out:   "index.html",
        title: "Gengoscript Documentation",
        desc:  indexDesc,
    }
    fs.write(outDir + "/index.html", string(wrapPage(index, Html(toc.str()))))
    written += 1

    // Sitemap for crawlers.
    var sitemap := std.string.builder()
    sitemap.write("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    sitemap.write("<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n")
    sitemap.write("<url><loc>" + siteBase + "</loc></url>\n")
    for page in pages {
        sitemap.write("<url><loc>" + siteBase + page.out + "</loc></url>\n")
    }
    sitemap.write("</urlset>\n")
    fs.write(outDir + "/sitemap.xml", sitemap.str())

    // Ship the stylesheet next to the pages.
    fs.write(outDir + "/" + cssPath, fs.read(staticDir + "/" + cssPath))
}

main()
