std := import("std")

type Percent int range 0..100
subtype FailingGrade Percent range 0..59
subtype PassingGrade Percent range 60..100

// Construction and printing
f FailingGrade = FailingGrade(40)
p PassingGrade = PassingGrade(85)
std.io.println(f)
std.io.println(p)

// Widening: subtype accepted where parent is expected
func showPercent(v Percent) {
    std.io.println(v)
}
showPercent(f)
showPercent(p)
showPercent(Percent(50))

// Explicit narrowing cast
base Percent = Percent(30)
narrow FailingGrade = FailingGrade(base)
std.io.println(narrow)

// Type attributes
std.io.println(FailingGrade.name)
std.io.println(FailingGrade.first)
std.io.println(FailingGrade.last)
