std := import("std")

s := "åäö"
std.io.println(std.core.len(s))
std.io.println(std.core.bytelen(s))
std.io.println(s[1])
std.io.println(s[1:3])
for i, ch in s {
  std.io.println(i)
  std.io.println(ch)
}

// Slice forms: half-open, prefix, suffix, full copy
a := "hello world"
std.io.println(a[1:5])
std.io.println(a[:5])
std.io.println(a[6:])
std.io.println(a[:])
