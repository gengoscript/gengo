std := import("std")

type Point struct {
    x int,
    y int,
}

func move(p Point, dx int, dy int) Point {
    p.x = p.x + dx
    p.y = p.y + dy
    return p
}

p := Point{ x: 1, y: 2 }
std.io.println(p.x)
std.io.println(p.y)

p2 := move(p, 10, 20)
std.io.println(p2.x)
std.io.println(p2.y)

// Compound assignment via set_field IC
p.x += 5
p.y += 7
std.io.println(p.x)
std.io.println(p.y)

// Multiple reads in a loop (exercises IC warm path)
total := 0
i := 0
for i < 100 {
    total = total + p.x + p.y
    i = i + 1
}
std.io.println(total)
