std := import("std")

// Extended math functions
t := std.math
std.io.println(t.acos(1))
std.io.println(t.asin(0))
std.io.println(t.atan(0))
std.io.println(t.atan2(1, 1))
std.io.println(t.cos(0))
std.io.println(t.sin(0))
std.io.println(t.tan(0))
std.io.println(t.cosh(0))
std.io.println(t.sinh(0))
std.io.println(t.tanh(0))
std.io.println(t.exp(1))
std.io.println(t.exp2(3))
std.io.println(t.trunc(3.7))
std.io.println(t.cbrt(27))
std.io.println(t.hypot(3, 4))
std.io.println(t.mod(7, 3))
std.io.println(t.nan())
std.io.println(t.is_nan(t.nan()))
std.io.println(t.is_inf(t.inf, 0))
std.io.println(t.pi)
std.io.println(t.e)
std.io.println(t.phi)
std.io.println(t.abs(-5))
std.io.println(t.sqrt(100))
std.io.println(t.floor(3.7))
std.io.println(t.ceil(3.1))
std.io.println(t.round(3.5))
std.io.println(t.pow(2, 10))
std.io.println(t.min(3, 7))
std.io.println(t.max(3, 7))
std.io.println(t.log(1))
std.io.println(t.log2(8))
std.io.println(t.log10(100))
