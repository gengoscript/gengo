std := import("std")

// std.sort.asc
t := std.sort
std.io.println(t.asc([3, 1, 2]))
std.io.println(t.asc(["c", "a", "b"]))
std.io.println(t.asc([]))
std.io.println(t.asc([1]))

// std.sort.desc
std.io.println(t.desc([1, 2, 3]))
std.io.println(t.desc(["a", "b", "c"]))
std.io.println(t.desc([]))

// std.sort.by
cmp := func(a int, b int) int {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}
std.io.println(t.by([3, 1, 2], cmp))
std.io.println(t.by([], cmp))
