std := import("std")

// Self-recursion tail call: deep recursion without stack overflow
func is_even_self(n int) bool {
    if n == 0 { return true }
    if n == 1 { return false }
    return is_even_self(n - 2)
}

std.io.println(is_even_self(10000))
std.io.println(is_even_self(10001))

// Mutual recursion tail call
func is_even(n int) bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}

func is_odd(n int) bool {
    if n == 0 { return false }
    return is_even(n - 1)
}

std.io.println(is_even(10000))
std.io.println(is_even(10001))
