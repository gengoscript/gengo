std := import("std")

func sum_until_sentinel(arr []int) int {
    acc := 0
    for x in arr {
        if x == 99 { break }
        acc += x
    }
    return acc
}

func sum_skip_zero(arr []int) int {
    acc := 0
    for x in arr {
        if x == 0 { continue }
        acc += x
    }
    return acc
}

func count_kv_before_sentinel(m map[string]int) int {
    count := 0
    for k, v in m {
        if k == "stop" { break }
        count += v
    }
    return count
}

func test_after_break_code_runs() int {
    count := 0
    for x in [1, 2, 3] {
        if x == 2 { break }
        count += 1
    }
    count += 10
    return count
}

func sum_cfor_with_break(n int) int {
    s := 0
    for i := 0; i < n; i++ {
        if i == 5 { break }
        s += i
    }
    return s
}

func sum_cfor_with_continue(n int) int {
    s := 0
    for i := 0; i < n; i++ {
        if i == 3 { continue }
        s += i
    }
    return s
}

func sum_with_local_in_break_block(arr []int) int {
    acc := 0
    for x in arr {
        if x == 99 {
            y := x * 2
            acc = acc + y
            break
        }
        acc += x
    }
    return acc
}

func sum_body_local(arr []int) int {
    acc := 0
    for x in arr {
        doubled := x * 2
        acc += doubled
    }
    return acc
}

std.io.println(sum_until_sentinel([1, 2, 99, 3, 4]))
std.io.println(sum_skip_zero([1, 0, 2, 0, 3]))
std.io.println(count_kv_before_sentinel({a: 10, b: 20, stop: 0, c: 30}))
std.io.println(test_after_break_code_runs())
std.io.println(sum_cfor_with_break(10))
std.io.println(sum_cfor_with_continue(6))
std.io.println(sum_with_local_in_break_block([1, 2, 99, 3]))
std.io.println(sum_body_local([1, 2, 3]))
