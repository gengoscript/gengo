std := import("std")

type Point struct {
    x int,
    y int,
    z int,
}

func sumPoint(p Point) int {
    return p.x + p.y + p.z
}

p := Point{ x: 1, y: 2, z: 3 }
total := 0
for i := 0; i < 200000; i++ {
    total = total + sumPoint(p)
}

std.io.println("struct-field-access")
std.io.println(total)
