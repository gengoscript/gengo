std := import("std")

s := "åäö🙂漢字"  // 6 runes, mixed byte widths
sum := 0

// Index hot path
for i := 0; i < 6; i += 1 {
    ch := s[i]
    sum += std.core.bytelen(ch)
}

// Slice hot path
for i := 0; i < 6; i += 1 {
    p := s[0:i]
    sum += std.core.bytelen(p)
}

// Iteration hot path
for idx, ch in s {
    sum += idx
    sum += std.core.bytelen(ch)
}

// Repeat to amplify runtime signal
for n := 0; n < 4000; n += 1 {
    for i := 0; i < 6; i += 1 {
        ch := s[i]
        sum += std.core.bytelen(ch)
    }
    for idx, ch in s {
        sum += idx
        sum += std.core.bytelen(ch)
    }
}

std.io.println("UTF8 hotpath")
std.io.println(sum)
