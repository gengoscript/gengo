std := import("std")

type Vec2 struct { x int, y int }
type Particle struct { pos Vec2, vel Vec2, mass int }

func (v Vec2) add(other Vec2) Vec2 {
    return Vec2{ x: v.x + other.x, y: v.y + other.y }
}

func (v Vec2) dot() int {
    return v.x * v.x + v.y * v.y
}

func (p Particle) step() Particle {
    return Particle{ pos: p.pos.add(p.vel), vel: p.vel, mass: p.mass }
}

func (p Particle) energy() int {
    return p.mass * p.vel.dot()
}

p := Particle{
    pos: Vec2{ x: 0, y: 0 },
    vel: Vec2{ x: 1, y: 2 },
    mass: 10
}

total := 0
for i := 0; i < 100000; i++ {
    p = p.step()
    total = total + p.energy()
}

std.io.println("nested-struct-methods")
std.io.println(total)
