std := import("std")

// ── Hex round-trip ──
func check_hex(s string) {
    enc := std.hex.encode(s)
    dec := std.hex.decode(enc)
    assert dec == s
}
check_hex("")
check_hex("a")
check_hex("ab")
check_hex("abc")
check_hex("hello world")

// ── Base64 round-trip ──
func check_b64(s string) {
    enc := std.base64.encode(s)
    dec := std.base64.decode(enc)
    assert dec == s
    encu := std.base64.url_encode(s)
    decu := std.base64.url_decode(encu)
    assert decu == s
}
check_b64("")
check_b64("f")
check_b64("fo")
check_b64("foo")
check_b64("foob")
check_b64("hello world")

// ── Perm distribution ──
func check_perm(n int) {
    p := std.rand.perm(n)
    assert std.core.len(p) == n
    seen := {}
    for i, v in p {
        assert v >= 0 && v < n
        assert !std.core.has(seen, v)
        seen[v] = true
    }
}
check_perm(0)
check_perm(1)
check_perm(2)
check_perm(5)
check_perm(10)

// ── Norm float is a number ──
v := std.rand.norm_float()
assert std.core.is_float(v)

// ── Calendar rollover ──
roll := std.time.from_unix(1735689600)  // 2025-01-01 00:00:00 UTC
r1 := roll.add_date(1, 0, 0)
assert r1.parts().year == 2026
r2 := roll.add_date(0, 1, 0)
assert r2.parts().month == 2
r3 := roll.add_date(0, 0, 1)
assert r3.parts().day == 2

dec31 := std.time.from_unix(1735689600 - 86400)  // 2024-12-31
jan1 := dec31.add_date(0, 0, 1)
assert jan1.parts().year == 2025
assert jan1.parts().month == 1
assert jan1.parts().day == 1

std.io.println("ALL ROUND-TRIP TESTS PASSED")
