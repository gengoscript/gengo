catalog := import("host:catalog")

type Quantity int range 1..10000
type WeightGrams int range 1..50000000
type CurrencyCode string predicate func(x) {
    return x == "SEK" or x == "EUR" or x == "USD" or x == "GBP"
}
type CountryCode string predicate func(x) {
    return x == "SE" or x == "NO" or x == "DK" or x == "FI" or
           x == "DE" or x == "NL" or x == "US"
}

var saved_reason string = ""
var saved_order_id string = ""
var saved_sku_id int = 0
var saved_quantity int = 0
var saved_weight_grams int = 0
var saved_currency string = ""
var saved_country string = ""

func reset_last() {
    saved_reason = ""
    saved_order_id = ""
    saved_sku_id = 0
    saved_quantity = 0
    saved_weight_grams = 0
    saved_currency = ""
    saved_country = ""
}

func reject(reason string) bool {
    reset_last()
    saved_reason = reason
    return false
}

pub func normalize(
    external_order_id string,
    status string,
    item string,
    qty int,
    weight_ounces int,
    currency string,
    country string,
) bool {
    reset_last()

    if status != "APPROVED" {
        return reject("legacy status not approved")
    }

    if not catalog.country_allowed(country) {
        return reject("country not enabled")
    }

    sku_id := catalog.sku_id(item)
    if sku_id == 0 {
        return reject("unknown sku")
    }

    grams := weight_ounces * 28
    q := Quantity(qty)
    w := WeightGrams(grams)
    c := CurrencyCode(currency)
    cc := CountryCode(country)

    _ = q
    _ = w
    _ = c
    _ = cc

    saved_order_id = external_order_id
    saved_sku_id = sku_id
    saved_quantity = qty
    saved_weight_grams = grams
    saved_currency = currency
    saved_country = country
    return true
}

pub func last_reason() string { return saved_reason }
pub func last_order_id() string { return saved_order_id }
pub func last_sku_id() int { return saved_sku_id }
pub func last_quantity() int { return saved_quantity }
pub func last_weight_grams() int { return saved_weight_grams }
pub func last_currency() string { return saved_currency }
pub func last_country() string { return saved_country }
