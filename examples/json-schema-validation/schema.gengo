std  := import("std")
core := std.core

// Schema for a "create user" request:
//   { "name": string, "age": int (0..150), "email": string (must contain "@"),
//     "role": "admin" | "member" | "guest" }
//
// Range and predicate constraints are enforced by the named-type constructor;
// a violation panics with TypeError, which each per-field check below
// recovers and turns into a plain error message instead of failing the
// whole request.

type Age   int    range 0..150
type Email string predicate func(x) {
    return std.string.contains(x, "@")
}
type Role string predicate func(x) {
    return x == "admin" or x == "member" or x == "guest"
}

var last_errors []string

func check_age(n int) (err string) {
    defer func() {
        if e := core.recover(); core.is_error(e) { err = "age: " + string(e) }
    }()
    _ = Age(n)
    return ""
}

func check_email(s string) (err string) {
    defer func() {
        if e := core.recover(); core.is_error(e) { err = "email: " + string(e) }
    }()
    _ = Email(s)
    return ""
}

func check_role(s string) (err string) {
    defer func() {
        if e := core.recover(); core.is_error(e) { err = "role: " + string(e) }
    }()
    _ = Role(s)
    return ""
}

// Validate a JSON document against the schema above. Returns true if the
// document is valid; otherwise false, with all violations available via
// errors_json() — not just the first one.
pub func validate(json string) (ok bool) {
    last_errors = []

    defer func() {
        if e := core.recover(); core.is_error(e) {
            last_errors = [string(e)]
            ok = false
        }
    }()

    doc := std.json.parse(json)
    if not core.is_map(doc) {
        last_errors = ["document: expected a JSON object"]
        return false
    }

    name_v  := doc["name"]
    age_v   := doc["age"]
    email_v := doc["email"]
    role_v  := doc["role"]

    if core.is_null(name_v) {
        last_errors = core.append(last_errors, "name: required")
    } else if not core.is_string(name_v) {
        last_errors = core.append(last_errors, "name: expected string, got " + core.type_of(name_v))
    }

    if core.is_null(age_v) {
        last_errors = core.append(last_errors, "age: required")
    } else if not core.is_int(age_v) {
        last_errors = core.append(last_errors, "age: expected int, got " + core.type_of(age_v))
    } else {
        e := check_age(int(age_v))
        if e != "" { last_errors = core.append(last_errors, e) }
    }

    if core.is_null(email_v) {
        last_errors = core.append(last_errors, "email: required")
    } else if not core.is_string(email_v) {
        last_errors = core.append(last_errors, "email: expected string, got " + core.type_of(email_v))
    } else {
        e := check_email(string(email_v))
        if e != "" { last_errors = core.append(last_errors, e) }
    }

    if core.is_null(role_v) {
        last_errors = core.append(last_errors, "role: required")
    } else if not core.is_string(role_v) {
        last_errors = core.append(last_errors, "role: expected string, got " + core.type_of(role_v))
    } else {
        e := check_role(string(role_v))
        if e != "" { last_errors = core.append(last_errors, e) }
    }

    return core.len(last_errors) == 0
}

pub func errors_json() string {
    return std.json.stringify(last_errors)
}
